{
  "buildCommand": "python manage.py collectstatic --noinput && python manage.py migrate --noinput",
  "outputDirectory": "staticfiles_build",
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}